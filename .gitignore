# Node / React
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Rust / Tauri target builds
target/
src-tauri/target/
src-tauri/gen/

# Editor & OS files — .claude/settings.local.json is per-developer, not shared
.claude/settings.local.json
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sln
*.sw?

# Temporary / Scratch
tmp/
*.tmp

# Python bytecode from the sidecars — regenerated on every run.
__pycache__/
*.pyc
.gstack/

# Toolchain installers people download into the repo root while setting up.
# They are multi-megabyte binaries that belong on the machine, not in history.
rustup-init.exe

# AI conversation logs. These are exports of assistant runs — they carry prompts,
# model replies and operator names, and they are not source. 22 were committed
# once, in b86b285; docs/purge-conversation-logs.md removes them from history.
scratch/conversations-backup-*/
scratch/*.db
